Route111_Text_BeckyPostBattle:
	.string "Si troben fòssils al desert,\n"

	.string "deu haver estat un mar abans.$"


Route111_Text_DustyIntro:
	.string "Fa trenta anys que busco ruïnes\n"

	.string "antigues!\l"

	.string "Se'm desafia?$"


Route111_Text_DustyDefeat:
