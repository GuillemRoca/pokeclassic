	.string "no he buscat Pokémon forts.$"


Route111_Text_DustyPostBattle:
	.string "Fa trenta anys que busco ruïnes\n"

	.string "antigues!\p"

	.string "No, espera, eren quaranta anys?\n"

	.string "Quants eren?$"


Route111_Text_DustyRegister:
