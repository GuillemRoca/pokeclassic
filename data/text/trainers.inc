	.string "antigues!\p"

	.string "No, espera, eren quaranta?\n"

	.string "En fi, se'm desafia?$"


Route111_Text_DustyRematchDefeat:
	.string "No he trobat ruïnes ni Pokémon\n"

	.string "forts…$"


Route111_Text_DustyPostRematch:
	.string "Fa trenta anys que busco ruïnes\n"

	.string "antigues!\p"

	.string "No, espera, eren quaranta\n"

	.string "anys que busco?\p"

	.string "Hmm… Podrien ser cinquanta…\n"

	.string "Quant de temps fa que hi soc?$"


Route111_Text_TravisIntro:
	.string "Estic ple d'energia!\n"

	.string "I el meu Pokémon també!$"


Route111_Text_TravisDefeat:
	.string "El meu Pokémon ha perdut l'energia…$"


Route111_Text_TravisPostBattle:
	.string "Quan veig un Entrenador ple\n"

	.string "d'energia, no puc evitar mirar.$"


Route111_Text_IreneIntro:
	.string "No sé on vas,\n"

	.string "però vols combatre?$"


Route111_Text_IreneDefeat:
	.string "Oh, ets indecemment bo!$"


Route111_Text_IrenePostBattle:
	.string "Penso si hauria d'anar al\n"

	.string "Mt. Chimney, però la vista\l"

	.string "d'aquí és molt bonica.$"


Route111_Text_DaisukeIntro:
	.string "Per entrenar-me, desafio tots\n"

	.string "els que trobo!$"


Route111_Text_DaisukeDefeat:
	.string "Em rendeixo!$"


Route111_Text_DaisukePostBattle:
	.string "Només puc seguir entrenant fins que\n"

	.string "pugui derrotar Entrenadors forts\l"

	.string "com tu.$"


Route111_Text_WiltonIntro:
