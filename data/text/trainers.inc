Route102_Text_CalvinIntro:
	.string "Si tens Pokémon, ets un Entrenador\n"

	.string "Pokémon oficial!\l"

	.string "No pots rebutjar el meu desafiament!$"


Route102_Text_CalvinDefeated:
	.string "Argh, he perdut…\n"

	.string "Hauria d'haver entrenat més…$"


Route102_Text_CalvinPostBattle:
	.string "Escolta, tu. Si ets fort,\n"

	.string "m'ho hauries d'haver dit abans!$"


Route102_Text_CalvinRegister:
	.string "He estat treballant dur des que\n"

	.string "et vaig veure.\p"

	.string "Vull tornar a combatre amb tu.\n"

	.string "Em registres al teu Pokénav?$"


Route102_Text_CalvinRegisterShort:
	.string "Vull tornar a combatre amb tu.\n"

	.string "Em registres al teu Pokénav?$"


Route102_Text_CalvinRematchIntro:
	.string "Des que vaig perdre contra tu,\n"

	.string "he entrenat els meus Pokémon.\l"

	.string "No pots rebutjar el meu desafiament!$"


Route102_Text_CalvinRematchDefeated:
	.string "Argh, he perdut…\n"

	.string "El meu entrenament no és correcte?$"


Route102_Text_CalvinRematchPostBattle:
	.string "Si et fas més fort,\n"

	.string "jo també em faré més fort.$"


Route102_Text_AllenIntro:
	.string "Acabes de fer-te Entrenador?\n"

	.string "Tots dos som principiants!$"


Route102_Text_AllenDefeated:
	.string "T'he desafiat perquè pensava\n"

	.string "que et podia guanyar…$"


Route102_Text_AllenPostBattle:
	.string "Encara no he guanyat cap cop…\n"

	.string "M'agradaria guanyar aviat…$"


Route102_Text_RickIntro:
	.string "Haha! Les mirades s'han creuat!\n"

	.string "T'atacaré amb els meus Pokémon Insecte!$"


Route102_Text_RickDefeated:
	.string "Au! Fora de combat!$"


Route102_Text_RickPostBattle:
	.string "Si creues la mirada amb un Entrenador,\n"

	.string "l'has de desafiar! És la norma!$"


Route102_Text_TianaIntro:
	.string "Seguiré guanyant per ser\n"

	.string "la millor Entrenadora.\p"

	.string "Ajuda'm a progressar!$"


Route102_Text_TianaDefeated:
	.string "He acabat fent progressar a tu…$"


Route102_Text_TianaPostBattle:
	.string "Per seguir guanyant, veig que haig\n"

	.string "d'atrapar més Pokémon.$"


Route103_Text_DaisyIntro:
	.string "Has sentit l'atracció de la nostra\n"

	.string "fragància reconfortant?$"


Route103_Text_DaisyDefeated:
	.string "No t'has deixat enganyar pel nostre\n"

	.string "aroma…$"


Route103_Text_DaisyPostBattle:
	.string "L'aromateràpia és una forma de\n"

	.string "guarició mental amb fragàncies.$"


Route103_Text_AmyIntro:
	.string "Amy: Soc l'Amy.\n"

	.string "I aquesta és la meva germaneta Liv.\l"

	.string "Combatim juntes!$"


Route103_Text_AmyDefeated:
	.string "Amy: Oh no, hem perdut.$"


Route103_Text_AmyPostBattle:
	.string "Amy: Has de pensar en moltes\n"

	.string "coses quan combats contra\l"

	.string "dos Entrenadors.$"


Route103_Text_AmyNotEnoughPokemon:
	.string "Amy: Oh, només tens un Pokémon\n"

	.string "amb tu.\l"

	.string "Així no pots combatre amb nosaltres.$"


Route103_Text_LivIntro:
	.string "Liv: Combatim juntes com un\n"

	.string "sol equip.$"


Route103_Text_LivDefeated:
	.string "Liv: Oh, hem perdut, germana…$"


Route103_Text_LivPostBattle:
	.string "Liv: Treballem perfectament juntes,\n"

	.string "la meva germana gran i jo…\p"

	.string "Però hem perdut igualment…$"


Route103_Text_AmyLivRegister:
	.string "Liv: De veritat, som molt millors…\n"

	.string "És cert! T'ho demostrarem!$"


Route103_Text_LivNotEnoughPokemon:
	.string "Liv: Si vols combatre amb nosaltres,\n"

	.string "has de tenir dos Pokémon!\l"

	.string "Si no, no és just!$"


Route103_Text_AmyRematchIntro:
	.string "Amy: Soc l'Amy.\n"

	.string "I aquesta és la meva germaneta Liv.\l"

	.string "Combatim juntes!$"


Route103_Text_AmyRematchDefeated:
	.string "Amy: Ohh!\n"

	.string "No hem pogut guanyar un altre cop…$"


Route103_Text_AmyRematchPostBattle:
	.string "Amy: Has de pensar en moltes\n"

	.string "coses quan combats contra\l"

	.string "dos Entrenadors.$"


Route103_Text_AmyRematchNotEnoughPokemon:
	.string "Amy: Oh, només tens un Pokémon\n"

	.string "amb tu.\l"

	.string "Així no pots combatre amb nosaltres.$"


Route103_Text_LivRematchIntro:
	.string "Liv: Combatim juntes com un\n"

	.string "sol equip.$"


Route103_Text_LivRematchDefeated:
	.string "Liv: Ohh, hem tornat a perdre…\n"

	.string "Germana…$"


Route103_Text_LivRematchPostBattle:
	.string "Liv: Treballem perfectament juntes,\n"

	.string "la meva germana gran i jo…\p"

	.string "Però per què hem tornat a perdre?$"


Route103_Text_LivRematchNotEnoughPokemon:
	.string "Liv: Si vols combatre amb nosaltres,\n"

	.string "has de tenir dos Pokémon!\l"

	.string "Si no, no és just!$"


Route103_Text_AndrewIntro:
	.string "Uf! El meu fil de pescar s'ha embolicat!\n"

	.string "Estic frustrat i de mal humor!\l"

	.string "Au va! Combat amb mi!$"


Route103_Text_AndrewDefeated:
	.string "Uf! He perdut!\n"

	.string "Ara estic encara més enfadat!$"


Route103_Text_AndrewPostBattle:
	.string "Uf, encara estic que bullo…\n"

	.string "Grrrrr…$"


Route103_Text_MiguelIntro:
	.string "El meu Pokémon és adorablement bonic!\n"

	.string "No siguis tímid, te'l mostraré!$"


Route103_Text_MiguelDefeated:
	.string "Oh, mare meva!\n"

	.string "El meu estimat Pokémon!$"


Route103_Text_MiguelPostBattle:
	.string "El meu Pokémon és adorable fins i\n"

	.string "tot quan està debilitat!$"


Route103_Text_MiguelRegister:
	.string "Faré que vinguis a veure el meu\n"

	.string "adorable Pokémon un altre cop!$"


Route103_Text_MiguelRematchIntro:
	.string "Ei, tu! El meu adorable Pokémon\n"

	.string "s'ha tornat encara més bonic!$"


Route103_Text_MiguelRematchDefeated:
	.string "Oh!\n"

	.string "El meu estimat Pokémon!$"


Route103_Text_MiguelRematchPostBattle:
	.string "Com més temps passo amb ell,\n"

	.string "més adorable es torna.$"


Route103_Text_PeteIntro:
	.string "Aquesta distància…\n"

	.string "Hauries de nedar-la!$"


Route103_Text_PeteDefeated:
	.string "Oh, molt bé!$"


Route103_Text_PetePostBattle:
	.string "Oh, ara t'entenc.\p"

	.string "Si tingués un Pokémon tan fidel,\n"

	.string "també voldria fer Surf amb ell!$"


Route103_Text_IsabelleIntro:
	.string "Vigila per on vas!\n"

	.string "Xocarem!$"


Route103_Text_IsabelleDefeated:
	.string "Ai…$"


Route103_Text_IsabellePostBattle:
	.string "Nedo malament i estava practicant…\n"

	.string "Perdona per quasi xocar amb tu.$"


Route103_Text_RhettIntro:
	.string "Uau!\n"

	.string "Com has entrat en un espai tan petit?$"


Route103_Text_RhettDefeated:
	.string "Uau!\n"

	.string "El nen és bo!$"


Route103_Text_RhettPostBattle:
	.string "T'agraden els espais estrets\n"

	.string "com aquest?$"


Route103_Text_MarcosIntro:
	.string "El so de la meva guitarra t'ha atret?$"


Route103_Text_MarcosDefeated:
	.string "El meu espectacle en solitari\n"

	.string "s'ha arruïnat…$"


Route103_Text_MarcosPostBattle:
	.string "Tocava la guitarra on hi havia poca\n"

	.string "gent, però s'han aplegat molts fans.\p"

	.string "Potser hauria de fer-me'n professional.$"


Route104_Text_GinaIntro:
	.string "Gina: Va, combat amb els nostres\n"

	.string "Pokémon!$"


Route104_Text_GinaDefeat:
	.string "Gina: Perdre em fa ràbia!$"


Route104_Text_GinaPostBattle:
	.string "Gina: Ets fort!\n"

	.string "Hem d'entrenar molt més!$"


Route104_Text_GinaNotEnoughMons:
	.string "Gina: Oh? Només un Pokémon?\n"

	.string "Doncs no combatrem amb tu.\p"

	.string "Si només té un Pokémon, se sentirà\n"

	.string "sol. No estaria bé.$"


Route104_Text_MiaIntro:
	.string "Mia: Som bessones, així que\n"

	.string "combatim juntes.$"


Route104_Text_MiaDefeat:
	.string "Mia: Hem combat juntes, però\n"

	.string "hem perdut totes dues…$"


Route104_Text_MiaPostBattle:
	.string "Mia: Entrenarem els Pokémon més\n"

	.string "per ser fortes com tu.$"


Route104_Text_MiaNotEnoughMons:
	.string "Mia: Vols combatre amb nosaltres?\p"

	.string "No pot ser si no tens dos Pokémon\n"

	.string "amb tu.\l"

	.string "Som massa fortes per a tu!$"


Route104_Text_IvanIntro:
	.string "Per què guardar el secret?\n"

	.string "Soc l'expert en Pokémon d'Aigua!\p"

	.string "Eh?\n"

	.string "No em coneixes?$"


Route104_Text_IvanDefeat:
	.string "Creia que no era dolent, si és que\n"

	.string "puc dir-ho, però sembla que no…$"


Route104_Text_IvanPostBattle:
	.string "Em vaig enganxar massa a la pesca.\n"

	.string "Vaig oblidar criar els meus Pokémon…$"


Route104_Text_BillyIntro:
	.string "Deixar petjades a la sorra és\n"

	.string "molt divertit!$"


Route104_Text_BillyDefeat:
	.string "Uaah! M'ha entrat sorra a les\n"

	.string "sabatilles! Tota rascosa!$"


Route104_Text_BillyPostBattle:
	.string "Vull deixar petjades a la sorra\n"

	.string "a tot arreu, però desapareixen\l"

	.string "de seguida…$"


Route104_Text_HaleyIntro:
	.string "Hauria de…\n"

	.string "O no hauria de…?\p"

	.string "Va, sí, combat!$"


Route104_Text_HaleyDefeat:
	.string "No hauria d'haver combat…$"


Route104_Text_HaleyPostBattle:
	.string "Si has de decidir i deixes que\n"

	.string "un altre triï per tu,\l"

	.string "te'n penediràs, passi el que\l"

	.string "passi.$"


Route104_Text_HaleyRegister1:
	.string "Ets fort, però hauria de registrar-te\n"

	.string "al meu Pokénav?\l"

	.string "Potser no hauria…\p"

	.string "Va, sí, et registraré!$"


Route104_Text_HaleyRegister2:
	.string "Ets fort, però hauria de registrar-te\n"

	.string "al meu Pokénav?\l"

	.string "Potser no hauria…\p"

	.string "Va, sí, et registraré!$"


Route104_Text_HaleyRematchIntro:
	.string "Vine, combat amb mi!$"


Route104_Text_HaleyRematchDefeat:
	.string "Ohh…\n"

	.string "Pensava que podia guanyar…$"


Route104_Text_HaleyPostRematch:
	.string "He decidit combatre, així que\n"

	.string "puc acceptar la derrota amb gràcia.\p"

	.string "Però estic disgustada igualment!$"


Route104_Text_WinstonIntro:
	.string "Oh, és clar, accepto el teu repte.\n"

	.string "Tinc molts diners.$"


Route104_Text_WinstonDefeat:
	.string "Per què no he pogut guanyar?$"


Route104_Text_WinstonPostBattle:
	.string "Hi ha coses que els diners no compren.\n"

	.string "Això són els Pokémon…$"


Route104_Text_WinstonRegister1:
	.string "Hm?\n"

	.string "Ah, tens un Pokénav.\p"

	.string "Et registraré amb gust.\n"

	.string "Al cap i a la fi, tinc molts diners.$"


Route104_Text_WinstonRegister2:
	.string "Hm?\n"

	.string "Ah, tens un Pokénav.\p"

	.string "Et registraré amb gust.\n"

	.string "Al cap i a la fi, tinc molts diners.$"


Route104_Text_WinstonRematchIntro:
	.string "Des que vaig perdre contra tu, he\n"

	.string "après moltes coses sobre Pokémon.$"


Route104_Text_WinstonRematchDefeat:
	.string "He tornat a perdre?\n"

	.string "Per què no puc guanyar?$"


Route104_Text_WinstonPostRematch:
	.string "Soc fabulosament ric, però no\n"

	.string "aconsegueixo guanyar amb Pokémon…\p"

	.string "El món Pokémon és tan profund…$"


Route104_Text_CindyIntro:
	.string "El destí ens ha fet trobar.\n"

	.string "Vols un combat?$"


Route104_Text_CindyDefeat:
	.string "Oh, vaja!$"


Route104_Text_CindyPostBattle:
	.string "“Hola” és el principi de “adéu”.\n"

	.string "Espero que ens tornem a veure.$"


Route104_Text_CindyRegister1:
	.string "Hola, ens tornem a trobar.\p"

	.string "Sembla que ens atraiem.\n"

	.string "Registrem-nos als nostres Pokénavs.$"


Route104_Text_CindyRegister2:
	.string "Hauríem de commemorar com\n"

	.string "ens atraiem.\p"

	.string "Registrem-nos als nostres\n"

	.string "Pokénavs.$"


Route104_Text_CindyRematchIntro:
	.string "Hola, ens tornem a trobar.\n"

	.string "Vols un combat?$"


Route104_Text_CindyRematchDefeat:
	.string "Oh, vaja…\n"

	.string "Ho he donat tot…$"


Route104_Text_CindyPostRematch:
	.string "“Hola” és el principi de “adéu”.\n"

	.string "Espero que ens tornem a veure.$"


Route104_Text_DarianIntro:
	.string "He pescat un Pokémon dur de pelar!\p"

	.string "Té una qualitat màgica!\n"

	.string "Segur que és molt dur, sí senyor!$"


Route104_Text_DarianDefeat:
	.string "Però què…$"


Route104_Text_DarianPostBattle:
	.string "Ei, Magikarp, no fas honor al teu\n"

	.string "nom, oi?$"


Route105_Text_FosterIntro:
	.string "Diuen que hi ha una roca mística\n"

	.string "per aquí.\l"

	.string "En saps alguna cosa?$"


Route105_Text_FosterDefeated:
	.string "Pensava massa en la roca, mentre\n"

	.string "els meus Pokémon eren dèbils…$"


Route105_Text_FosterPostBattle:
	.string "Puc passar hores mirant una bona\n"

	.string "roca sense cansar-me'n.$"


Route105_Text_LuisIntro:
	.string "Uf! Pensava que un nen s'ofegava\n"

	.string "quan t'he vist.\p"

	.string "Sembla que estàs bé, què tal\n"

	.string "un combat?$"


Route105_Text_LuisDefeated:
	.string "Glub… Glub…$"


Route105_Text_LuisPostBattle:
	.string "Si t'ofegues, el senyal és moure\n"

	.string "un braç cap a la platja.$"


Route105_Text_DominikIntro:
	.string "Nedar pel mar blau profund…\n"

	.string "És la millor sensació!$"


Route105_Text_DominikDefeated:
	.string "He perdut…\n"

	.string "Ara estic deprimit…$"


Route105_Text_DominikPostBattle:
	.string "Per què el mar és blau?\p"

	.string "Ho vaig aprendre al Museu\n"

	.string "de Slateport, però ho he oblidat.$"


Route105_Text_BeverlyIntro:
	.string "El meu cos pesa menys a l'aigua.\n"

	.string "És com si hagués aprimat!$"


Route105_Text_BeverlyDefeated:
	.string "Estic flotant…$"


Route105_Text_PostBattle:
	.string "El teu pes es redueix a una desena\n"

	.string "part a l'aigua.\p"

	.string "Això vol dir que jo…\n"

	.string "Ei! No et diré el meu pes!$"


Route105_Text_ImaniIntro:
	.string "El cel blau, blau…\n"

	.string "El mar immens…\l"

	.string "Tot és tan tranquil…$"


Route105_Text_ImaniDefeated:
	.string "He perdut mentre descansava!$"


Route105_Text_ImaniPostBattle:
	.string "Vull que em diguin que és relaxant\n"

	.string "estar amb mi. Hihi.$"


Route105_Text_AndresIntro:
	.string "Estic convençut que el mar amaga\n"

	.string "secrets.$"


Route105_Text_AndresDefeated:
	.string "Sí…\n"

	.string "No soc bo combatent…$"


Route105_Text_AndresPostBattle:
	.string "Segur que hi ha molts secrets per\n"

	.string "descobrir als mars del món.\p"

	.string "Penso trobar-los tots!$"


Route105_Text_AndresRegister:
	.string "Eh? Soc tan dèbil, però em vols\n"

	.string "registrar al teu Pokénav?$"


Route105_Text_AndresRematchIntro:
	.string "T'he dit que soc dèbil…\n"

	.string "Segur que vols fer-ho?$"


Route105_Text_AndresRematchDefeated:
	.string "Sí…\n"

	.string "No creia que pogués guanyar.$"


Route105_Text_AndresRematchPostBattle:
	.string "Potser soc dèbil combatent, però\n"

	.string "la meva passió per explorar és\l"

	.string "imbatible.\p"

	.string "Viatjaré per tots els mars\n"

	.string "del món!$"


Route105_Text_JosueIntro:
	.string "Estic esgotat de nedar.\n"

	.string "No hi estic acostumat.\p"

	.string "Necessito un combat per canviar!$"


Route105_Text_JosueDefeated:
	.string "He perdut perquè he combat al mar.$"


Route105_Text_JosuePostBattle:
	.string "Sí, per a mi, el cel és molt millor\n"

	.string "que el mar.$"


Route106_Text_ElliotIntro:
	.string "Què prefereixes, pescar al mar\n"

	.string "o al riu?$"


Route106_Text_ElliotDefeated:
	.string "Com en la pesca d'altura, he perdut\n"

	.string "espectacularment!$"


Route106_Text_ElliotPostBattle:
	.string "Pescar és genial tant al mar com\n"

	.string "al riu.\l"

	.string "Hi estàs d'acord, oi?$"


Route106_Text_ElliotRegister:
	.string "Pescar és genial, però combatre\n"

	.string "també. Ens podem tornar a veure?$"


Route106_Text_ElliotRematchIntro:
	.string "He pescat molts Pokémon.\n"

	.string "Et mostraré un combat impressionant!$"


Route106_Text_ElliotRematchDefeated:
	.string "He tornat a perdre espectacularment!$"


Route106_Text_ElliotRematchPostBattle:
	.string "Guanyis o perdis, els Pokémon\n"

	.string "són genials!\l"

	.string "Hi estàs d'acord, oi?$"


Route106_Text_NedIntro:
	.string "Què fa la gent quan necessita anar\n"

	.string "al lavabo?\p"

	.string "I si pico un peix gros mentre soc\n"

	.string "al lavabo? No puc anar-hi…$"


Route106_Text_NedDefeated:
	.string "He perdut perquè estic aguantant\n"

	.string "les ganes d'anar al lavabo…$"


Route106_Text_NedPostBattle:
	.string "Ai, no! Tinc la sensació que picarà\n"

	.string "un peix gros!$"


Route106_Text_DouglasIntro:
	.string "Hahaha! Corro malament, però a\n"

	.string "l'aigua no m'atraparàs!$"


Route106_Text_DouglasDefeated:
	.string "Em rendeixo!$"


Route106_Text_DouglasPostBattle:
	.string "En una cursa de natació no perdria…$"


Route106_Text_KylaIntro:
	.string "El mar és el meu pati. No seré\n"

	.string "suau perquè siguis un nen!$"


Route106_Text_KylaDefeated:
	.string "Has anat suau amb mi, per\n"

	.string "casualitat?$"


Route106_Text_KylaPostBattle:
	.string "Deixar-se portar per les ones…\n"

	.string "M'encanta! Per què no ho proves?$"


Route107_Text_DarrinIntro:
	.string "Badall…\p"

	.string "M'he degut adormir mentre\n"

	.string "flotava amb les ones.$"


Route107_Text_DarrinDefeated:
	.string "Ahaha, he perdut…\n"

	.string "Crec que faré una becaina…$"


Route107_Text_DarrinPostBattle:
	.string "Flotar i ser bressolat per les ones\n"

	.string "és com dormir en un llit ben\l"

	.string "còmode.$"


Route107_Text_TonyIntro:
	.string "El mar és com el meu pati.\n"

	.string "Combatim!$"


Route107_Text_TonyDefeated:
	.string "He perdut a casa meva…\n"

	.string "Estic en xoc!$"


Route107_Text_TonyPostBattle:
	.string "Nedo pels mars amb el cor ple\n"

	.string "de somnis…\p"

	.string "És una cançó!\n"

	.string "En fi, segueixo nedant.$"


Route107_Text_TonyRegister:
	.string "M'has deixat bocabadat!\n"

	.string "Bé, perquè no m'oblidis…$"


Route107_Text_TonyRematchIntro:
	.string "Nedant pel mar immens,\n"

	.string "el meu Pokémon s'ha fet més fort!$"


Route107_Text_TonyRematchDefeated:
	.string "Quin xoc!\p"

	.string "El meu Pokémon s'ha fet més fort,\n"

	.string "però jo soc dèbil com a Entrenador!$"


Route107_Text_TonyRematchPostBattle:
	.string "El que aprens en combat et fa\n"

	.string "un Entrenador més fort.\l"

	.string "Les ones m'ho han ensenyat.$"


Route107_Text_DeniseIntro:
	.string "Coneixes un poblet que es diu\n"

	.string "Dewford?$"


Route107_Text_DeniseDefeated:
	.string "Odio això!$"


Route107_Text_DenisePostBattle:
	.string "Una dita estranya s'ha posat de moda\n"

	.string "al Saló Dewford.$"


Route107_Text_BethIntro:
	.string "Volies combatre amb mi?\n"

	.string "Endavant, va!$"


Route107_Text_BethDefeated:
	.string "No he estat a la teva alçada.$"


Route107_Text_BethPostBattle:
